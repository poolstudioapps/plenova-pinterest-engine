# ---------------------------------------------------------------------------
# Gemini (REQUIRED) - https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional model overrides. Defaults are set in lib/config.ts.
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# gemini-3.1-flash-image is the default. gemini-3-pro-image is ~2x slower
# and pricier for comparable editorial quality - override only if needed.
# GEMINI_IMAGE_MODEL=gemini-3-pro-image  # higher quality, ~2x slower/pricier

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of the deployment. Used to build the OAuth redirect URI.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Destination link attached to every Pin (AppsFlyer OneLink).
APPSFLYER_ONELINK=https://plenova.onelink.me/nQZF/0f2sata

# ---------------------------------------------------------------------------
# Pinterest (OPTIONAL until the developer app is approved)
# https://developers.pinterest.com/apps/
# ---------------------------------------------------------------------------
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/callback
# Set to "sandbox" to target api-sandbox.pinterest.com while the app is pending.
PINTEREST_API_ENV=production

# Escape hatch while the developer app is in trial review: Pinterest withholds
# the app secret then, so OAuth cannot run. A manually generated token can be
# pasted here instead. Declare its real scopes - trial tokens are read-only,
# and the engine refuses to attempt a publish it knows will be rejected.
PINTEREST_ACCESS_TOKEN=
PINTEREST_TOKEN_SCOPES=pins:read,boards:read,user_accounts:read

# ---------------------------------------------------------------------------
# Secrets at rest (REQUIRED once Pinterest is connected)
# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Auto-provisioned by Vercel when you attach a Blob store. Required in
# production for public image URLs + persistent Pin records.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Cron (protects /api/cron/publish). Vercel sends this automatically.
# ---------------------------------------------------------------------------
CRON_SECRET=
