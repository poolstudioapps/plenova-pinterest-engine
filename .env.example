# ---------------------------------------------------------------------------
# Gemini (REQUIRED) - https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional model overrides. Defaults are set in lib/config.ts.
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# gemini-3.1-flash-image is the default. gemini-3-pro-image is ~2x slower
# and pricier for comparable editorial quality - override only if needed.
# GEMINI_IMAGE_MODEL=gemini-3-pro-image  # higher quality, ~2x slower/pricier

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# OPTIONAL. On Vercel this is auto-detected from VERCEL_PROJECT_PRODUCTION_URL,
# so leave it empty unless you are serving from a custom domain.
# Only set it once you know the final domain - it must match the redirect URI
# registered on the Pinterest app exactly.
NEXT_PUBLIC_APP_URL=

# Destination link attached to every Pin (AppsFlyer OneLink).
APPSFLYER_ONELINK=https://plenova.onelink.me/nQZF/0f2sata

# ---------------------------------------------------------------------------
# Pinterest (OPTIONAL until the developer app is approved)
# https://developers.pinterest.com/apps/
# ---------------------------------------------------------------------------
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# OPTIONAL too: derived from the app URL above when left empty.
PINTEREST_REDIRECT_URI=
# Set to "sandbox" to target api-sandbox.pinterest.com while the app is pending.
PINTEREST_API_ENV=production

# Escape hatch while the developer app is in trial review: Pinterest withholds
# the app secret then, so OAuth cannot run. A manually generated token can be
# pasted here instead. Declare its real scopes - trial tokens are read-only,
# and the engine refuses to attempt a publish it knows will be rejected.
PINTEREST_ACCESS_TOKEN=
PINTEREST_TOKEN_SCOPES=pins:read,boards:read,user_accounts:read

# ---------------------------------------------------------------------------
# Secrets at rest (REQUIRED once Pinterest is connected)
# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Auto-provisioned by Vercel when you connect a Blob store. Required in
# production for public image URLs + persistent Pin records.
#
# The store MUST be created with PUBLIC access: Pinterest fetches Pin images by
# URL with no auth header, so a private store makes publishing impossible.
#
# Connecting a store sets BLOB_STORE_ID and the SDK authenticates via the
# ambient OIDC token - nothing else to do. BLOB_READ_WRITE_TOKEN is only set if
# you tick "Add a read-write token env var"; either one works.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Dashboard password (REQUIRED in production)
#
# The tool triggers paid Gemini generations and posts to real social accounts,
# so it must not sit open on a public URL. Leave empty locally to skip the gate.
# The legal pages and OAuth callbacks stay public - see lib/auth.ts.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Legal pages (read by TikTok / Pinterest during app review)
# ---------------------------------------------------------------------------
LEGAL_OPERATOR=L'Atelier UGC
LEGAL_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Cron (protects /api/cron/publish). Vercel sends this automatically.
# ---------------------------------------------------------------------------
CRON_SECRET=
